# ============================================================
# Astral Forum — copiez en .env et adaptez
# ============================================================
APP_NAME="Astral Forum"
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_CHARSET=UTF-8
APP_BASE_URL=http://astral-forum.local

DB_DRIVER=sqlite
DB_DATABASE=database/forum.sqlite

AUTH_REGISTRATION=direct

FORUM_PRIMARY=#9f1239
FORUM_PRIMARY_SOFT=#fce7ef

# Édition auteur (minutes) ; 0 = illimité
FORUM_EDIT_WINDOW_MINUTES=30
FORUM_AUTO_SUBSCRIBE=true
FORUM_NOTIFY_ON_REPLY=true
FORUM_THROTTLE_TOPIC_MAX=5
FORUM_THROTTLE_TOPIC_DECAY=600
FORUM_THROTTLE_REPLY_MAX=10
FORUM_THROTTLE_REPLY_DECAY=300
FORUM_THROTTLE_FAQ_MAX=3
FORUM_THROTTLE_FAQ_DECAY=900

CACHE_DRIVER=file
CACHE_PATH=storage/cache
CACHE_PREFIX=forum:
CACHE_TTL=3600

MAIL_DRIVER=mail
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM=noreply@localhost
MAIL_FROM_NAME="Astral Forum"
