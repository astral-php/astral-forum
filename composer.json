{
  "name": "astral-php/astral-forum",
  "description": "Astral Forum — forums, sujets, posts et FAQ modérée (create-project starter 2.1)",
  "type": "project",
  "version": "0.5.1",
  "license": "MIT",
  "keywords": [
    "astral",
    "php",
    "mvc",
    "forum"
  ],
  "homepage": "https://github.com/astral-php/astral-forum",
  "require": {
    "php": "^8.3",
    "astral-php/astral-auth-extra": "^0.2",
    "astral-php/astral-cache": "^0.1",
    "astral-php/astral-core": "^2.1",
    "astral-php/astral-form": "^0.1.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:8083 -t public public/router.php",
    "qa": "php bin/qa-parcours.php",
    "test": "phpunit --configuration phpunit.xml"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
